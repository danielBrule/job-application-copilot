# Copy this file to .env only when you need to override a default.
# Every setting below is optional. Leave it commented out to use its shown default.
# Relative paths are resolved from the directory where the application is started.

# JAC_DATA_DIR=data
# JAC_DATABASE_PATH=<JAC_DATA_DIR>/database/job_application_copilot.db
# JAC_CV_FOLDER=<JAC_DATA_DIR>/cvs
# JAC_LOGS_FOLDER=<JAC_DATA_DIR>/logs
# JAC_REFERENCE_FOLDER=<JAC_DATA_DIR>/reference
# JAC_TEMPLATE_DIR=templates
# JAC_DOCUMENT_B_ROUTING_CONFIG_PATH=<JAC_REFERENCE_FOLDER>/routing/document-b-lane-routes.yaml

# JAC_ASSESSMENT_MODEL=gpt-5.6-sol
# JAC_ASSESSMENT_REASONING_EFFORT=medium
# JAC_ASSESSMENT_MAX_RETRIES=2
# JAC_ASSESSMENT_RETRY_BASE_DELAY_SECONDS=1
# JAC_ASSESSMENT_WORKER_COUNT=1
# JAC_CV_WORKER_COUNT=1

# JAC_LOG_LEVEL=INFO
# JAC_LOG_MAX_SIZE_MB=5
# JAC_LOG_BACKUP_COUNT=5
# JAC_OPENAI_VECTOR_STORE_TIMEOUT_SECONDS=300
# JAC_ASSESSMENT_MODEL=gpt-5.6-terra
# JAC_ASSESSMENT_REASONING_EFFORT=medium
# JAC_CV_GENERATION_MODEL=gpt-5.6-terra
# JAC_CV_GENERATION_REASONING_EFFORT=medium
# JAC_CV_GENERATION_MAX_RETRIES=2

# JAC_DEFAULT_SOURCE=LinkedIn
# JAC_DEFAULT_LOCATION=UK
# JAC_DEFAULT_LANGUAGE=EN
# JAC_MINIMUM_FRENCH_REFERENCE_EXAMPLES=2

# Required only before an action that contacts OpenAI. Keep the real key in .env
# or the process environment; never commit it.
OPENAI_API_KEY=
